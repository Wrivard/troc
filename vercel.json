{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "env": {
    "CATALOG_MODE": "demo"
  },
  "installCommand": "corepack pnpm install --frozen-lockfile --ignore-scripts",
  "buildCommand": "corepack pnpm --filter @workspace/api-server build && corepack pnpm --filter @workspace/marketplace build",
  "outputDirectory": "artifacts/marketplace/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "artifacts/{api-server/dist/serverless.cjs,marketplace/{dist,dist-server}/**}"
    }
  },
  "routes": [
    {
      "src": "^/(?:seller/(?:apply|dashboard|team)|admin/seller-applications|early-access/(?:admin|withdraw))/?$",
      "headers": {
        "Cache-Control": "private, no-store",
        "X-Robots-Tag": "noindex, noarchive",
        "Referrer-Policy": "no-referrer"
      },
      "continue": true
    },
    {
      "src": "^/catalog-art/[a-f0-9]{20}-[0-9]+\\.webp$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/(?:search|games/[^/]+|sets/[^/]+|product/[^/]+|store/[^/]+|sitemap\\.xml|sitemap-pages\\.xml|robots\\.txt)?$",
      "dest": "/api/index"
    },
    {
      "src": "^/api(?:/.*)?$",
      "dest": "/api/index"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/.*$",
      "dest": "/index.html"
    }
  ]
}
