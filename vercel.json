{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "env": {
    "CATALOG_MODE": "demo"
  },
  "installCommand": "pnpm install --frozen-lockfile --ignore-scripts",
  "buildCommand": "pnpm --filter @workspace/marketplace build",
  "outputDirectory": "artifacts/marketplace/dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "artifacts/marketplace/{dist,dist-server}/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/",
      "destination": "/api/index"
    },
    {
      "source": "/search",
      "destination": "/api/index"
    },
    {
      "source": "/games/:slug",
      "destination": "/api/index"
    },
    {
      "source": "/sets/:slug",
      "destination": "/api/index"
    },
    {
      "source": "/product/:slug",
      "destination": "/api/index"
    },
    {
      "source": "/store/:slug",
      "destination": "/api/index"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index"
    },
    {
      "source": "/sitemap-pages.xml",
      "destination": "/api/index"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
