{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "TROC's single source of truth. The supplied written brand specifications define both themes. TROC Dark is the default. Brand red remains #FF2D3D; a deeper action red gives white button labels AA contrast.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#F4F4F4" },
      "foreground": { "$value": "#0E0E0E" },
      "card": { "$value": "#FFFFFF" },
      "cardForeground": { "$value": "#0E0E0E" },
      "popover": { "$value": "#FFFFFF" },
      "popoverForeground": { "$value": "#0E0E0E" },
      "primary": { "$value": "#DE1E30", "$description": "Accessible action red; 4.85:1 with white." },
      "primaryForeground": { "$value": "#FFFFFF" },
      "secondary": { "$value": "#E8E8E8" },
      "secondaryForeground": { "$value": "#171717" },
      "muted": { "$value": "#EDEDED" },
      "mutedForeground": { "$value": "#656565" },
      "accent": { "$value": "#FF2D3D", "$description": "Exact supplied TROC red. Use charcoal labels, not small white text." },
      "accentForeground": { "$value": "#0E0E0E" },
      "destructive": { "$value": "#C61728" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "border": { "$value": "#DEDEDE" },
      "input": { "$value": "#858585" },
      "ring": { "$value": "#C61728" },
      "chart1": { "$value": "#DE1E30" },
      "chart2": { "$value": "#171717" },
      "chart3": { "$value": "#656565" },
      "chart4": { "$value": "#8A8A8A" },
      "chart5": { "$value": "#B8B8B8" },
      "sidebar": { "$value": "#FFFFFF" },
      "sidebarForeground": { "$value": "#3B3B3B" },
      "sidebarBorder": { "$value": "#DEDEDE" },
      "sidebarPrimary": { "$value": "#C61728" },
      "sidebarPrimaryForeground": { "$value": "#FFFFFF" },
      "sidebarAccent": { "$value": "#FCE9EB" },
      "sidebarAccentForeground": { "$value": "#B51625" },
      "sidebarRing": { "$value": "#C61728" }
    },
    "dark": {
      "background": { "$value": "#0E0E0E" },
      "foreground": { "$value": "#F4F4F4" },
      "card": { "$value": "#171717" },
      "cardForeground": { "$value": "#F4F4F4" },
      "popover": { "$value": "#202020" },
      "popoverForeground": { "$value": "#F4F4F4" },
      "primary": { "$value": "#DE1E30" },
      "primaryForeground": { "$value": "#FFFFFF" },
      "secondary": { "$value": "#2A2A2A" },
      "secondaryForeground": { "$value": "#F4F4F4" },
      "muted": { "$value": "#222222" },
      "mutedForeground": { "$value": "#A3A3A3" },
      "accent": { "$value": "#FF2D3D" },
      "accentForeground": { "$value": "#0E0E0E" },
      "destructive": { "$value": "#FF5260" },
      "destructiveForeground": { "$value": "#0E0E0E" },
      "border": { "$value": "#2A2A2A" },
      "input": { "$value": "#686868" },
      "ring": { "$value": "#FF5260" },
      "chart1": { "$value": "#FF2D3D" },
      "chart2": { "$value": "#F4F4F4" },
      "chart3": { "$value": "#B8B8B8" },
      "chart4": { "$value": "#8A8A8A" },
      "chart5": { "$value": "#656565" },
      "sidebar": { "$value": "#111111" },
      "sidebarForeground": { "$value": "#A3A3A3" },
      "sidebarBorder": { "$value": "#2A2A2A" },
      "sidebarPrimary": { "$value": "#FF5260" },
      "sidebarPrimaryForeground": { "$value": "#0E0E0E" },
      "sidebarAccent": { "$value": "#2B171A" },
      "sidebarAccentForeground": { "$value": "#FF6571" },
      "sidebarRing": { "$value": "#FF5260" }
    }
  },
  "semantic": {
    "$description": "TROC aliases supplement, not replace, the shared 32-role schema. Status meanings always have text and icons, not additional brand hues.",
    "light": {
      "surface": { "$value": "{color.light.card}" },
      "surface-elevated": { "$value": "{color.light.popover}" },
      "surface-hover": { "$value": "{color.light.muted}" },
      "border-strong": { "$value": "{color.light.input}" },
      "text-primary": { "$value": "{color.light.foreground}" },
      "text-secondary": { "$value": "#505050" },
      "text-muted": { "$value": "{color.light.mutedForeground}" },
      "accent-hover": { "$value": "#C81728" },
      "accent-pressed": { "$value": "#AF1423" },
      "focus": { "$value": "{color.light.ring}" },
      "success": { "$value": "#3D3D3D" },
      "positive": { "$value": "{semantic.light.success}" },
      "warning": { "$value": "#505050" },
      "danger": { "$value": "{color.light.destructive}" },
      "shadow-sm": { "$value": "0 1px 2px rgb(0 0 0 / 0.04)" },
      "shadow-md": { "$value": "0 8px 24px rgb(0 0 0 / 0.10)" }
    },
    "dark": {
      "surface": { "$value": "{color.dark.card}" },
      "surface-elevated": { "$value": "{color.dark.popover}" },
      "surface-hover": { "$value": "{color.dark.muted}" },
      "border-strong": { "$value": "{color.dark.input}" },
      "text-primary": { "$value": "{color.dark.foreground}" },
      "text-secondary": { "$value": "#C4C4C4" },
      "text-muted": { "$value": "{color.dark.mutedForeground}" },
      "accent-hover": { "$value": "#C81728" },
      "accent-pressed": { "$value": "#AF1423" },
      "focus": { "$value": "{color.dark.ring}" },
      "success": { "$value": "#D1D1D1" },
      "positive": { "$value": "{semantic.dark.success}" },
      "warning": { "$value": "#C4C4C4" },
      "danger": { "$value": "{color.dark.destructive}" },
      "shadow-sm": { "$value": "0 1px 2px rgb(0 0 0 / 0.10)" },
      "shadow-md": { "$value": "0 8px 24px rgb(0 0 0 / 0.25)" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": { "$value": ["Plus Jakarta Sans", "Arial", "sans-serif"] },
      "serif": { "$value": ["Plus Jakarta Sans", "Arial", "sans-serif"], "$description": "No secondary serif in the locked brand." },
      "mono": { "$value": ["SFMono-Regular", "Consolas", "monospace"] }
    },
    "scale": {
      "display": { "$value": { "size": "3.75rem", "lineHeight": "1.08", "weight": 800, "tracking": "-0.05em" } },
      "h1": { "$value": { "size": "2.5rem", "lineHeight": "1.16", "weight": 700, "tracking": "-0.045em" } },
      "h2": { "$value": { "size": "1.75rem", "lineHeight": "1.25", "weight": 700, "tracking": "-0.035em" } },
      "h3": { "$value": { "size": "1.375rem", "lineHeight": "1.35", "weight": 700, "tracking": "-0.025em" } },
      "h4": { "$value": { "size": "1.125rem", "lineHeight": "1.4", "weight": 600, "tracking": "-0.02em" } },
      "h5": { "$value": { "size": "1rem", "lineHeight": "1.5", "weight": 600, "tracking": "-0.01em" } },
      "h6": { "$value": { "size": "0.875rem", "lineHeight": "1.5", "weight": 600, "tracking": "0" } },
      "body-large": { "$value": { "size": "1.125rem", "lineHeight": "1.7", "weight": 400, "tracking": "-0.015em" } },
      "body": { "$value": { "size": "1rem", "lineHeight": "1.65", "weight": 400, "tracking": "-0.01em" } },
      "body-small": { "$value": { "size": "0.875rem", "lineHeight": "1.6", "weight": 400, "tracking": "0" } },
      "label": { "$value": { "size": "0.8125rem", "lineHeight": "1.5", "weight": 600, "tracking": "0" } },
      "caption": { "$value": { "size": "0.75rem", "lineHeight": "1.5", "weight": 400, "tracking": "0" } },
      "metadata": { "$value": { "size": "0.75rem", "lineHeight": "1.5", "weight": 500, "tracking": "0.015em" } },
      "price-large": { "$value": { "size": "1.75rem", "lineHeight": "1.2", "weight": 700, "tracking": "-0.035em" } },
      "price-small": { "$value": { "size": "0.9375rem", "lineHeight": "1.5", "weight": 700, "tracking": "-0.015em" } },
      "table": { "$value": { "size": "0.8125rem", "lineHeight": "1.5", "weight": 500, "tracking": "0" } }
    }
  },
  "radius": { "base": { "$value": "0.5rem" } },
  "spacing": { "base": { "$value": "0.25rem" } },
  "foundation": {
    "space": {
      "1": { "$value": "4px" }, "2": { "$value": "8px" }, "3": { "$value": "12px" },
      "4": { "$value": "16px" }, "5": { "$value": "20px" }, "6": { "$value": "24px" },
      "8": { "$value": "32px" }, "10": { "$value": "40px" }, "12": { "$value": "48px" },
      "16": { "$value": "64px" }, "20": { "$value": "80px" }, "24": { "$value": "96px" }
    },
    "container": { "reading": { "$value": "720px" }, "content": { "$value": "1120px" }, "wide": { "$value": "1440px" } },
    "breakpoint": { "mobile": { "$value": "480px" }, "tablet": { "$value": "768px" }, "desktop": { "$value": "1024px" }, "wide": { "$value": "1440px" } },
    "motion": { "fast": { "$value": "120ms" }, "normal": { "$value": "180ms" }, "slow": { "$value": "220ms" }, "easing": { "$value": "cubic-bezier(0.2, 0, 0, 1)" } },
    "z": { "base": { "$value": 0 }, "sticky": { "$value": 20 }, "dropdown": { "$value": 40 }, "overlay": { "$value": 60 }, "toast": { "$value": 80 } },
    "control": { "small": { "$value": "36px" }, "default": { "$value": "44px" }, "large": { "$value": "48px" } }
  }
}