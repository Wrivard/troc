# Runtime only. Never prefix secrets with VITE_. Load through Replit Secrets or shell.
DATABASE_URL=postgresql://troc_app:REPLACE@HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE
APP_ORIGIN=http://localhost:5173
PORT=3001
# Frontend development uses its own PORT=5173 and BASE_PATH=/.
API_ORIGIN=http://127.0.0.1:3001

# Local review only; switch to postgres after database and licenses are configured.
CATALOG_MODE=demo
PUBLIC_SITE_URL=http://localhost:5173
# Offline catalog operator only; never supply owner credentials to the web runtime.
# IMPORT_ACTOR_ID=UUID_OF_ACTIVE_CATALOG_MODERATOR
